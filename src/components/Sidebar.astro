---
import Go from './icons/Go.astro'
import Search from 'astro-pagefind/components/Search.astro'
---

<div class="flex items-center gap-4 p-4 bg-base-100 shadow-sm">
  <a href="/" data-astro-transition="false" class="btn btn-ghost btn-circle text-xl cursor-pointer">
    <Go class="w-16 h-16" /> 
  </a>
  Apuntes Go
  <div class="flex-1"></div>
  <div class="w-80">
    <Search
      class="pagefind-ui"
      placeholder="Buscar..."
      showImages={false}
      resetFilters={false}
      showSubResults={true}
      excerptLength={30}
    />
  </div>
</div>

<script>
  // Re-inicializar PagefindUI después de cada transición de Astro
  document.addEventListener('astro:after-swap', () => {
    const searchContainer = document.querySelector('.pagefind-ui');
    if (searchContainer && searchContainer._pagefindUI) {
      // El componente ya se auto-inicializa con data-pagefind-ui
      searchContainer._pagefindUI.refresh?.();
    }
  });
</script>


